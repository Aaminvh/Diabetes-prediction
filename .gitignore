# Virtual environments
.venv/
venv/
env/

# Python bytecode / caches
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Jupyter
.ipynb_checkpoints/

# Data: the Kaggle CSV is not redistributed (licence: Data files © Original Authors); download it into Data/raw/
Data/raw/*
!Data/raw/.gitkeep
Data/raw/*.zip
Data/processed/*
!Data/processed/.gitkeep

# Model outputs / large artefacts
Outputs/*
!Outputs/.gitkeep
*.pkl
*.joblib
*.h5
*.onnx

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Environment secrets
.env

# Local AI-assistant notes and settings (kept on this machine only)
CLAUDE.md
.claude/
